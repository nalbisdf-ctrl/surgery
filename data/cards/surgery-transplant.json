[{"id":"L1624809861299","topic":"transplant","q":"Treatment Gastric + esophageal varices&#x2753;&#x1F352;","a":"<ol><li>Endoscopic <mark>sclerotherapy </mark>or <mark>band ligation</mark> (in gastric varices &#xD8;scleroT)</li><li>Somatostatin (<mark>Octreotide</mark>) [constriction splanchnic artery &#x2192; &#x2193;portal pressure]</li></ol><p>&#x2192; if continous &#x2192; <mark>Balloon tamponade </mark></p><p>&#x2192; if continous further </p><br><p>&#x2192; candiate for liver transplant &#x2192; <mark>TIPS</mark></p><p>&#x2192;&#xD8;transplant-candidate &#x2192; <mark>Porto-caval shunt </mark></p><p>&#x2192; After bleeding stops: <mark>beta-blocker + endoscopic</mark> variceal therapy </p><img data-src=\"data:image/jpeg;base64,\" alt=\"\"><p></p><br>1ee00bebbdc77de033e08324f6a76e81fee7c63a.png","src":"4.Spleen, Abdominal emergencies, bariatric surgery","kind":"lect"}]