[{"id":"L1624809861261","topic":"spleen","q":"Absent spleen will lead to &#x2191;risk of infections of what bacteria?&#x1F352;","a":"<p><mark>&quot;SHIN&quot;</mark></p><p>Streptococc. pneumoniae</p><p>Hemophilus influenza</p><p>Neisseria menigococcus </p><img data-src=\"data:image/jpeg;base64,\" alt=\"\"><br>668d3fca740694e122e1bce15966ad91d42a211f.jpeg","src":"4.Spleen, Abdominal emergencies, bariatric surgery","kind":"lect"},{"id":"L1624809861263","topic":"spleen","q":"What are the 3 indications for splenectomy?&#x1F352;","a":"&#x1F4A1;<br>As a rule: Every spleen pathology is treated with splectomy <ol><li>Therapeutic &#x2192; <mark>Tumors</mark>, <mark>Trauma</mark>, Hydatic cyst, <mark>Abcess</mark>, <mark>Splenic vein</mark> <mark>thrombosis </mark>w/ gastric varices </li><li>Diagnostic &#x2192; <mark>Lymphomas</mark>, tumor with unknown etiology</li><li>Tactical &#x2192; <mark>Total gastrectomy</mark>, <mark>corporea-caudal pancreatectomy</mark>, <mark>left hemicolectomy </mark></li></ol>","src":"4.Spleen, Abdominal emergencies, bariatric surgery","kind":"lect"},{"id":"L1624809861265","topic":"spleen","q":"What are complications of splenectomy?&#x1F352;","a":"<ul><li><mark>bleeding</mark></li><li>acute <mark>pancreatitis</mark></li><li><mark>thromboembolism </mark>(when thrombosis-prophylaxis absent)</li><li>sepsis (by <mark>SHIN</mark>) [<em>esp in children]</em></li><li>splenic arteriovenous <mark>fistulas </mark>(see later)</li></ul>","src":"4.Spleen, Abdominal emergencies, bariatric surgery","kind":"lect"},{"id":"L1624809861267","topic":"spleen","q":"What are the 2 types of splenic hematoma?&#x1F352;","a":"<ul><li><mark>subcapsular </mark>&#x2192; capsule intact &#x2192; might develop to rupture (hemoperitoneum) or delayed hemorrhage or perisplenic hematoma or resorption</li><li><mark>perisplenic </mark>hematoma &#x2192; capsular effraction due to trauma or secondary to subcapsular hematoma &#x2192; might lead to secondary rupture (hemiperitoneum)</li></ul>","src":"4.Spleen, Abdominal emergencies, bariatric surgery","kind":"lect"},{"id":"L1624809861269","topic":"spleen","q":"What is a complication of splenic hematomas (&#xD8;rupture)?&#x1F352;","a":"<p>get infected &#x2192; splenic abcess </p>","src":"4.Spleen, Abdominal emergencies, bariatric surgery","kind":"lect"},{"id":"L1624809861273","topic":"spleen","q":"Treatment options in splenic trauma? How do you choose?&#x1F352;","a":"<ol><li><mark>Volemic rebalancing</mark></li><li>Cardiopulmonary resucitation </li><li>Depending on injury:<ol><li>&#xD8;Bleeding + &#xD8;assoc. lesions + stable &#x2192; <mark>Non-surgical spleen preservation treatment </mark>&#x2192; hospitalization (possible delayed rupture)</li><li>Low Parenchymal injury + experienced surgeon &#x2192; <mark>Spleen preserving surgery </mark>&#x2192; capsular suture, tissue adhesive, argon plasma coagulation)</li><li>Bleeding cant be stopped by other means OR total spleen damage &#x2192; <mark>Complete splenectomy </mark></li></ol></li></ol>","src":"4.Spleen, Abdominal emergencies, bariatric surgery","kind":"lect"},{"id":"L1711200227183","topic":"spleen","q":"splenic trauma, splenic injury grading, treatment","a":"treatment: embolization of affected vessels, ligation of splenic pedicle, splenectomy<br>??","src":"Surgery open questions - MK","kind":"open"},{"id":"L1711200532082","topic":"spleen","q":"splenic hydatid cyst - imaging, treatment, etc","a":"imaging: US, ELISA<br>treatment: partial splenectomy, after evacuation by aspiration- scolicidal agent, total splenectomy","src":"Surgery open questions - MK","kind":"open"}]