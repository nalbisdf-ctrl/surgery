[{"id": "OI059", "topic": "cornea", "kind": "img", "q": "<p class=\"muted small\">Lecture 8 – Cornea – slide 7: what does this picture show? Describe it.</p><img data-src=\"data:image/jpeg;base64,\" alt=\"\">", "a": "<h4>Corneal ulcer</h4><ul class=\"sl\"><li class=\"l0\">Symptoms and signs.</li><li class=\"l0\">corneal perforation with prolapse of the anterior uvea</li><li class=\"l0\">congested iris miotic pupil</li><li class=\"l0\">purulent exudate  in anterior chamber</li><li class=\"l1\">from the inflamed iris</li><li class=\"l0\">panophthalmitis.</li><li class=\"l1\">a suppurating inflammation of the uvea after perforation</li></ul>", "src": "Lecture 8 – Cornea"}, {"id": "OI060", "topic": "cornea", "kind": "img", "q": "<p class=\"muted small\">Lecture 8 – Cornea – slide 17: what does this picture show? Describe it.</p><img data-src=\"data:image/jpeg;base64,\" alt=\"\">", "a": "<h4>Disciform keratitis</h4><ul class=\"sl\"><li class=\"l0\">herpes simplex</li><li class=\"l0\">a discoidal, well defined opacity in the corneal center</li><li class=\"l0\">diminishing the corneal sensibility.</li><li class=\"l0\">lasts months or years without resolution,</li><li class=\"l1\">always a dense corneal opacity as a sequela</li><li class=\"l0\">treatment</li><li class=\"l1\">corticosteroids locally</li><li class=\"l1\">radiation therapy.</li><li class=\"l1\">surgery keratoplasty</li><li class=\"l2\">should the opacity persist</li></ul>", "src": "Lecture 8 – Cornea"}, {"id": "OI061", "topic": "cornea", "kind": "img", "q": "<p class=\"muted small\">Lecture 8 – Cornea – slide 21: what does this picture show? Describe it.</p><img data-src=\"data:image/jpeg;base64,\" alt=\"\">", "a": "<h4>Signs</h4><ul class=\"sl\"><li class=\"l1\">As in lagophthalmic</li><li class=\"l1\">loss of corneal sensitivity.</li><li class=\"l1\">the blinking frequency drops below the level required to ensure that the cornea remains moist.</li><li class=\"l0\">Symptoms:</li><li class=\"l1\">free of pain,</li><li class=\"l1\">foreign body sensation</li><li class=\"l1\">eyelid swelling.</li><li class=\"l0\">Treatment  identical exposure keratitis</li></ul>", "src": "Lecture 8 – Cornea"}]