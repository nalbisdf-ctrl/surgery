[{"id": "EA0216", "topic": "calcium", "kind": "anki", "q": "<div><strong>General </strong></div>", "a": "<summary></summary>", "src": "ENDO Anki deck – "}, {"id": "EA0217", "topic": "calcium", "kind": "anki", "q": "<div><em>Osmosis</em></div>", "a": "<summary></summary><figure><div><a href=\"https://drive.google.com/file/d/1shfOfa0zdndDd_NlBVWZdpOMPZystWhf/view?usp=drivesdk\">Hyperparathyroidism.mp4</a><br><a href=\"https://drive.google.com/file/d/1shfOfa0zdndDd_NlBVWZdpOMPZystWhf/view?usp=drivesdk\">https://drive.google.com/file/d/1shfOfa0zdndDd_NlBVWZdpOMPZystWhf/view?usp=drivesdk</a></div></figure>", "src": "ENDO Anki deck – "}, {"id": "EA0218", "topic": "calcium", "kind": "anki", "q": "<div>NinjaNerd </div>", "a": "<summary></summary><figure><div><a href=\"https://youtu.be/y64aXKCkHk4\">https://youtu.be/y64aXKCkHk4</a></div></figure><iframe width='560' height='315' src='https://www.youtube.com/embed/y64aXKCkHk4?' frameborder='0' allowfullscreen></iframe>", "src": "ENDO Anki deck – "}, {"id": "EA0219", "topic": "calcium", "kind": "anki", "q": "<div><strong>Hormones</strong></div>", "a": "<summary></summary><figure><div><a href=\"https://drive.google.com/file/d/1NqYyryYJHDqOnRgRDpdl3xFPBmVZj-Fi/view?usp=drivesdk\">Parathyroid hormone.mp4</a><br><a href=\"https://drive.google.com/file/d/1NqYyryYJHDqOnRgRDpdl3xFPBmVZj-Fi/view?usp=drivesdk\">https://drive.google.com/file/d/1NqYyryYJHDqOnRgRDpdl3xFPBmVZj-Fi/view?usp=drivesdk</a></div></figure>", "src": "ENDO Anki deck – "}, {"id": "EA0220", "topic": "calcium", "kind": "anki", "q": "<div>What are the biological effects of PTH?</div>", "a": "<summary></summary><p>Incr. Ca + decr. Phosphate in blood + </p><ul><li>incr. Ca reabsorption</li></ul><ul><li>decr. reabsorption Phosphate </li></ul><ul><li>stimulation of aktive VitD in kidney</li></ul><ul><li>incr. intestinal absorption (indirect through VitD)</li></ul><ul><li>incr. bone resorption</li></ul>", "src": "ENDO Anki deck – "}, {"id": "EA0221", "topic": "calcium", "kind": "anki", "q": "<div>What are the effects of Calcitonin?</div>", "a": "<summary></summary><ul><li>inhibit osteoclast</li></ul><ul><li>inhibit reabsorption of phosphate + calcium </li></ul>", "src": "ENDO Anki deck – "}, {"id": "EA0222", "topic": "calcium", "kind": "anki", "q": "<div>What is the major complication of VitD deficiency in children + adults?</div>", "a": "<summary></summary><p>children → rickets</p><p>adults → osteomalacia</p>", "src": "ENDO Anki deck – "}, {"id": "EA0223", "topic": "calcium", "kind": "anki", "q": "<div>How does VitD synthesis occur?</div>", "a": "<summary></summary><p>ProVit3 → PreVitD3 → liver → 25hydroxycholecalciferol (Calcidiol) → kidney → Calcitriol (active VitD)</p>", "src": "ENDO Anki deck – "}, {"id": "EA0224", "topic": "calcium", "kind": "anki", "q": "<div>What incr. the level of VitD?</div>", "a": "<summary></summary><p>low Phosphate + Ca</p><p>high PTH </p>", "src": "ENDO Anki deck – "}, {"id": "EA0225", "topic": "calcium", "kind": "anki", "q": "<div>What regulates PTH secretion?</div>", "a": "<summary></summary><p>incr. PTH in:</p><ul><li>decr. Ca</li></ul><ul><li>decr. Mg </li></ul><ul><li>decr. VitD</li></ul><p>→ &amp;vice versa </p>", "src": "ENDO Anki deck – "}, {"id": "EA0226", "topic": "calcium", "kind": "anki", "q": "<div><strong>Hypercalcemia </strong></div>", "a": "<summary></summary><ul><li><details><summary>Is there a medical therapy you can consider?😵</summary><ul><li><mark>Calcimimetic agents </mark>→ activate Ca-sensing R </li></ul><p>→ i.e. Cinacalcet</p><p><br></p></details></li></ul>", "src": "ENDO Anki deck – "}, {"id": "EA0227", "topic": "calcium", "kind": "anki", "q": "<div><em>Osmosis</em></div>", "a": "<summary></summary><figure><div><a href=\"https://drive.google.com/file/d/1NqYyryYJHDqOnRgRDpdl3xFPBmVZj-Fi/view?usp=drivesdk\">Parathyroid hormone.mp4</a><br><a href=\"https://drive.google.com/file/d/1NqYyryYJHDqOnRgRDpdl3xFPBmVZj-Fi/view?usp=drivesdk\">https://drive.google.com/file/d/1NqYyryYJHDqOnRgRDpdl3xFPBmVZj-Fi/view?usp=drivesdk</a></div></figure>", "src": "ENDO Anki deck – "}, {"id": "EA0228", "topic": "calcium", "kind": "anki", "q": "<div>Basics</div>", "a": "<summary></summary>", "src": "ENDO Anki deck – "}, {"id": "EA0229", "topic": "calcium", "kind": "anki", "q": "<div>What indicates primary hyperparathyroidism + what indicates others causes?</div>", "a": "<summary></summary><p>high PTH + high Ca → primary or tertiary </p><p>high Ca + low PTH → others </p>", "src": "ENDO Anki deck – "}, {"id": "EA0230", "topic": "calcium", "kind": "anki", "q": "<div>What are these other causes?</div>", "a": "<summary></summary><ul><li>malignancies → 2nd most common cause of hyperCa  </li></ul>", "src": "ENDO Anki deck – "}, {"id": "EA0231", "topic": "calcium", "kind": "anki", "q": "<div>Primary Hyperparathyroidism😵🐖</div>", "a": "<summary></summary><ul><li><details><summary>Is there a medical therapy you can consider?😵</summary><ul><li><mark>Calcimimetic agents </mark>→ activate Ca-sensing R </li></ul><p>→ i.e. Cinacalcet</p><p><br></p></details></li></ul>", "src": "ENDO Anki deck – "}, {"id": "EA0232", "topic": "calcium", "kind": "anki", "q": "<div>What are the most common causes for primary HPT?😵</div>", "a": "<summary></summary><ul><li>single <mark>adenoma </mark>(80%)</li></ul><ul><li>Primary <mark>hyperplasia </mark>(20%)</li></ul><ul><li>Parathyroid <mark>carcinoma </mark>(1-2%)</li></ul><p>→ also associated with <mark>MEN 1 + 2a</mark>! </p>", "src": "ENDO Anki deck – "}, {"id": "EA0233", "topic": "calcium", "kind": "anki", "q": "<div>How do most of the patient clinically present?😵</div>", "a": "<summary></summary><p>85% assymptomatic dected by screening</p>", "src": "ENDO Anki deck – "}, {"id": "EA0234", "topic": "calcium", "kind": "anki", "q": "<div>What are all clinical presentation possibilities?😵🐖</div>", "a": "<summary></summary><ul><li>renal <ul><li><mark>stones</mark></li></ul><ul><li><mark>nephrocalcinosis</mark></li></ul><ul><li>decr. GFR</li></ul><ul><li><mark>polyuria + polydipsia </mark></li></ul></li></ul><ul><li>bones<ul><li><mark>osteitis fibrosa cystica</mark> → bone pain + patological </li></ul></li></ul><ul><li><mark>CNS </mark>→ depression, lethargy, psychosis, lethargy </li></ul><ul><li>Neuromuscular → <mark>muscle weakness, hypertonia </mark></li></ul><ul><li>CV→ <mark>HT + Bradyc + short QT </mark></li></ul><ul><li>GI →<mark>constipation, pancreatitis, peptic ulcers</mark></li></ul><ul><li>eye → <mark>keratopathy</mark></li></ul>", "src": "ENDO Anki deck – "}, {"id": "EA0235", "topic": "calcium", "kind": "anki", "q": "<div>What will the lab lady find in the blood + urine in primary HPT?😵</div>", "a": "<summary></summary><p>blood:</p><ul><li>high Ca</li></ul><ul><li>Low ( or n) Phosphorus </li></ul><ul><li>high PTH </li></ul><ul><li>high active VitD</li></ul><p>urine:</p><ul><li>high Ca</li></ul><ul><li>high Phosphorus </li></ul>", "src": "ENDO Anki deck – "}, {"id": "EA0236", "topic": "calcium", "kind": "anki", "q": "<div>What other investigation you wanna consider?😵</div>", "a": "<summary></summary><p><span>ARE THE OTHER ORGANS GUCCI?</span></p><p>→ Renal function test</p><p>→ Renal imaging </p><p><mark>→ xray </mark></p><div><ul><li><mark> Bone mineral density</mark> (see osteoporosis)</li></ul><ul><li><mark>Subperiosteal resorption</mark> → phalanges + skull (salt+pepper)</li></ul><ul><li><mark>Bone cysts </mark>or <mark>browntumor </mark>→ osteolytic  </li></ul><ul><li>pathologic fx</li></ul></div><p></p><figure><figcaption>brown tumor</figcaption></figure><figure><figcaption>bone cyst</figcaption></figure>", "src": "ENDO Anki deck – "}, {"id": "EA0237", "topic": "calcium", "kind": "anki", "q": "<div>What is the definite treatment of HPT?</div>", "a": "<summary></summary><p><mark>parathyroidectomy</mark></p><p>→ unilateral if single lesion localized by imaging (Technetium sestamibi scan + US)</p><p>→ otherwise bilateral exploration → removal of all glands that are enlarged </p>", "src": "ENDO Anki deck – "}, {"id": "EA0238", "topic": "calcium", "kind": "anki", "q": "<div>So what are the indications for surgery ?&nbsp;</div>", "a": "<summary></summary><ul><li><mark>hypercalcemia </mark>symptoms</li></ul><ul><li><mark>Renal dmg - </mark>GFR &lt;60, Renal stones</li></ul><ul><li>Bone diseases: <mark>Osteitis fibrosa cystica</mark>, <mark>T-score &gt; -2.5SD</mark> (see later), <mark>vertebral fx</mark></li></ul><ul><li><mark>Pancreatitis</mark></li></ul>", "src": "ENDO Anki deck – "}, {"id": "EA0239", "topic": "calcium", "kind": "anki", "q": "<div>What might appear after surgery? What are you gonna do about it?</div>", "a": "<summary></summary><p><mark>transitory post-op hypocalcemia</mark></p><p>→ <mark>hungry bone syndrome</mark> + functional inhibition of remaining PT-gland</p><p>⇒ give <mark>Ca + aktive VitD</mark>-metabolite </p>", "src": "ENDO Anki deck – "}, {"id": "EA0240", "topic": "calcium", "kind": "anki", "q": "<div>Is there a medical therapy you can consider for primary &amp; tertiary HPT?😵</div>", "a": "<summary></summary><ul><li><mark>Calcimimetic agents </mark>→ activate Ca-sensing R </li></ul><p>→ i.e. Cinacalcet</p><p><br></p>", "src": "ENDO Anki deck – "}, {"id": "EA0241", "topic": "calcium", "kind": "anki", "q": "<div>Secondary Hyperparathyroidism (acutally no HyperCa!)😵</div>", "a": "<summary></summary>", "src": "ENDO Anki deck – "}, {"id": "EA0242", "topic": "calcium", "kind": "anki", "q": "<div>How are the lab values in secondary Hyperparathyrodism ?😵</div>", "a": "<summary></summary><ul><li>high PTH</li></ul><ul><li>low Ca</li></ul><ul><li>high Phosphate</li></ul><ul><li>low VitD</li></ul>", "src": "ENDO Anki deck – "}, {"id": "EA0243", "topic": "calcium", "kind": "anki", "q": "<div>What are causes for sec. HPT?</div>", "a": "<summary></summary><ul><li>chronic RF</li></ul><ul><li>VitD deficiency</li></ul>", "src": "ENDO Anki deck – "}, {"id": "EA0244", "topic": "calcium", "kind": "anki", "q": "<div>How will the clinical presentation be?😵</div>", "a": "<summary></summary><ul><li><a href=\"https://www.notion.so/Endocrinology-01a5dbd626254601b1e691c83f3301e5\">osteitis fibrosa (cystica)</a></li></ul><ul><li>Osteomalacia </li></ul>", "src": "ENDO Anki deck – "}, {"id": "EA0245", "topic": "calcium", "kind": "anki", "q": "<div>How do you treat secondary HPT?😵</div>", "a": "<summary></summary><ul><li>Calcitriol (VitD)</li></ul><ul><li>Calicum supplements</li></ul><ul><li>Phosphate restriction (or with phosphate binders)</li></ul>", "src": "ENDO Anki deck – "}, {"id": "EA0246", "topic": "calcium", "kind": "anki", "q": "<div>Tertiary Hyperparathyroidism </div>", "a": "<summary></summary>", "src": "ENDO Anki deck – "}, {"id": "EA0247", "topic": "calcium", "kind": "anki", "q": "<div>Definition of tertiary HPT</div>", "a": "<summary></summary><ul><li><a href=\"https://next.amboss.com/us/article/UI0bXh#Ze68781981f01766eb6f2131c36ab51f2\">Hypercalcemia</a> caused by autonomous and refractory secretion of <a href=\"https://next.amboss.com/us/article/Hg0K92#Z82b80df8e4df1330c0aa8506a5aa4525\">PTH</a> secondary to untreated <a href=\"https://next.amboss.com/us/article/gg0Fu2#Z3b7ab7d9f4ca01fe61e3f88622a8d630\">sHPT</a></li></ul>", "src": "ENDO Anki deck – "}, {"id": "EA0248", "topic": "calcium", "kind": "anki", "q": "<div><strong>Hypocalcemia</strong></div>", "a": "<summary></summary><ul><li><details><summary>What are other symptoms + signs of hypocalcemia?😵</summary><ul><li>hyperirritability + <mark>anxiety </mark>+ shortness of breath</li></ul><ul><li><mark>prolonged QT</mark></li></ul><ul><li>refractory <mark>congestive heart failure </mark></li></ul><ul><li><mark>subcapsular cataracts </mark></li></ul><ul><li><mark>dry + brittle hair, skin, nails</mark></li></ul><p><br /></p><ul><li>children → <mark>dental hypoplacia + mental retardation</mark></li></ul><ul><li>if VitD-def → <mark>lethargy, prox myopathy, bone pain</mark></li></ul><ul><li>if Hypoparathyoidism → <mark>mental slowing, personality disturbance, parkinson-like-syndrome, papilloedema </mark></li></ul>", "src": "ENDO Anki deck – "}, {"id": "EA0249", "topic": "calcium", "kind": "anki", "q": "<div>Basics</div>", "a": "<summary></summary><ul><li><details><summary>What are other symptoms + signs of hypocalcemia?😵</summary><ul><li>hyperirritability + <mark>anxiety </mark>+ shortness of breath</li></ul><ul><li><mark>prolonged QT</mark></li></ul><ul><li>refractory <mark>congestive heart failure </mark></li></ul><ul><li><mark>subcapsular cataracts </mark></li></ul><ul><li><mark>dry + brittle hair, skin, nails</mark></li></ul><p><br /></p><ul><li>children → <mark>dental hypoplacia + mental retardation</mark></li></ul><ul><li>if VitD-def → <mark>lethargy, prox myopathy, bone pain</mark></li></ul><ul><li>if Hypoparathyoidism → <mark>mental slowing, personality disturbance, parkinson-like-syndrome, papilloedema </mark></li></ul>", "src": "ENDO Anki deck – "}, {"id": "EA0250", "topic": "calcium", "kind": "anki", "q": "<div>What leads to <span>acute</span> hypocalcemia? 😵</div>", "a": "<summary></summary><ul><li><mark>rhadomyolyisi</mark>s<mark> </mark>→ flood of Phosphate from injurey muscle → bind all the Ca (PTH + VitD can adapt fast enough)</li></ul><ul><li>Ac. <mark>Pancreatitis</mark></li></ul><ul><li><mark>Hungry bone</mark> syndrome</li></ul>", "src": "ENDO Anki deck – "}, {"id": "EA0251", "topic": "calcium", "kind": "anki", "q": "<div>What are causes for chronic hypocalcemia?😵</div>", "a": "<summary></summary><ul><li><mark>Hypoparathyroidism</mark></li></ul><ul><li><mark>Pseudohypoparathyroidism </mark>(<span>Resistance </span>to <span>PTH</span>)</li></ul><ul><li><mark>Failure </mark>to <mark>produce </mark>active <mark>VitD </mark>metabolit (calicitriol) → Deficiency, Hereditary (Rickets type 1)</li></ul><ul><li><mark>Resistance </mark>to <mark>VitD</mark>-metabolite action → Hereditary Rickets type 2 (defection VitD-R)</li></ul>", "src": "ENDO Anki deck – "}, {"id": "EA0252", "topic": "calcium", "kind": "anki", "q": "<div>What are neuromuscular features of hypocalcemia? 😵</div>", "a": "<summary></summary><p><span><mark>incr neuromuscular exitability</mark></span></p><p>→ tingling</p><p>→ numbness</p><p>→ cramps </p><p>→ <mark>Tetany → Carpopedal spasm </mark>(severe: laryngeal spasm) </p><p>⇒ <mark>Cvostek + Trousseau</mark> sign positive 🤌</p><figure><div><a href=\"https://www.youtube.com/watch?v=kvmwsTU0InQ&amp;ab_channel=NEJMvideo\">https://www.youtube.com/watch?v=kvmwsTU0InQ&amp;ab_channel=NEJMvideo</a></div></figure><iframe width='560' height='315' src='https://www.youtube.com/embed/kvmwsTU0InQ?' frameborder='0' allowfullscreen></iframe>", "src": "ENDO Anki deck – "}, {"id": "EA0253", "topic": "calcium", "kind": "anki", "q": "<div>What are other symptoms + signs of hypocalcemia?😵</div>", "a": "<summary></summary><ul><li>hyperirritability + <mark>anxiety </mark>+ shortness of breath</li></ul><ul><li><mark>prolonged QT</mark></li></ul><ul><li>refractory <mark>congestive heart failure </mark></li></ul><ul><li><mark>subcapsular cataracts </mark></li></ul><ul><li><mark>dry + brittle hair, skin, nails</mark></li></ul><p><br /></p><ul><li>children → <mark>dental hypoplacia + mental retardation</mark></li></ul><ul><li>if VitD-def → <mark>lethargy, prox myopathy, bone pain</mark></li></ul><ul><li>if Hypoparathyoidism → <mark>mental slowing, personality disturbance, parkinson-like-syndrome, papilloedema </mark></li></ul>", "src": "ENDO Anki deck – "}, {"id": "EA0254", "topic": "calcium", "kind": "anki", "q": "<div>Hypoparathyroidism😵</div>", "a": "<summary></summary>", "src": "ENDO Anki deck – "}, {"id": "EA0255", "topic": "calcium", "kind": "anki", "q": "<div>What are the important blood levels in Hypoparathyroidism ?</div>", "a": "<summary></summary><ul><li>low Ca</li></ul><ul><li>low PTH</li></ul>", "src": "ENDO Anki deck – "}, {"id": "EA0256", "topic": "calcium", "kind": "anki", "q": "<div>Etiologies for Hypothyroidism?&nbsp;</div>", "a": "<summary></summary><ul><li><mark>post-op </mark>(thyroidectomy)</li></ul><ul><li><mark>auto-immune </mark>(isolated <span>Anti-CaSensitiveR</span> or <span>type 1 polyglandular autoimm. sd</span>: with adrenal insuff + mucocutaneous candidias) </li></ul><ul><li>rare: <mark>DiGeorge sd</mark></li></ul><ul><li><mark>infiltration </mark>(hemochromatosis, wilson)</li></ul><ul><li><mark>postirradiation </mark>(radioactive iodine therapy in graves)</li></ul><ul><li><mark>idiopathic </mark></li></ul>", "src": "ENDO Anki deck – "}, {"id": "EA0257", "topic": "calcium", "kind": "anki", "q": "<div>What are the clinical features additonally to the one <a href=\"https://www.notion.so/Endocrinology-01a5dbd626254601b1e691c83f3301e5\">above </a>😵</div>", "a": "<summary></summary><ul><li><mark>urolithiasis </mark></li></ul><ul><li><mark>renal insuff </mark></li></ul>", "src": "ENDO Anki deck – "}, {"id": "EA0258", "topic": "calcium", "kind": "anki", "q": "<div>What are your lab findings in&nbsp;Hypothyroidism ?</div>", "a": "<summary></summary><p>Blood:</p><ul><li>low Ca</li></ul><ul><li>high Phosph</li></ul><ul><li>low PTH</li></ul><p>Urine:</p><ul><li>High Ca</li></ul><ul><li>low Phosph</li></ul>", "src": "ENDO Anki deck – "}, {"id": "EA0259", "topic": "calcium", "kind": "anki", "q": "<div>How can you treat hypoparathyroidism if not acute hypocalcemia is present?😵</div>", "a": "<summary></summary><ul><li><mark>Calcium </mark>supplements orally</li></ul><ul><li>Activated <mark>VitD </mark>metabolites</li></ul><ul><li><mark>Mg </mark></li></ul><ul><li><mark><em>Recombinant human PTH</em></mark><em> (amboss) → </em>lecture: \"not yet approved\"</li></ul>", "src": "ENDO Anki deck – "}, {"id": "EA0260", "topic": "calcium", "kind": "anki", "q": "<div>How do you treat acute hypocalcemia (tetany crisis)😵</div>", "a": "<summary></summary><ul><li><mark>Calcium gluconate i.v.</mark></li></ul><ul><li>Diazepam + <mark>anxiolytics</mark></li></ul><ul><li><mark>Oral Ca + rapid acting VitD </mark></li></ul><ul><li>breath into bag (when resp. alkalosis due to anxiety)</li></ul>", "src": "ENDO Anki deck – "}, {"id": "EA0261", "topic": "calcium", "kind": "anki", "q": "<div>Pseudohypoparathyoridism😵</div>", "a": "<summary></summary>", "src": "ENDO Anki deck – "}, {"id": "EA0262", "topic": "calcium", "kind": "anki", "q": "<div>What are the 2 types of&nbsp;</div><h3>Pseudohypoparathyroidism and&nbsp;</h3><div>&nbsp;their characteristics?😵</div>", "a": "<summary></summary><ul><li><span>type 1A</span> → same biochemical features + <mark>Albright hereditary osteodystopy </mark>phenotype → <span>short</span>, <span>round </span>face, short neck, <span>obesity</span>, <span>brachydactyly</span>, <span>short metatarsal</span> + -carpals;<span> reduced intelligence</span> </li></ul><ul><li><span>type 1B</span> → isolated <span><mark>resistance to PTH</mark></span> → <ul><li>hypocalcemia, </li></ul><ul><li>hyperPhosp, </li></ul><ul><li>secondary hyperparathyroidism → high PTH </li></ul></li></ul>", "src": "ENDO Anki deck – "}, {"id": "EA0263", "topic": "calcium", "kind": "anki", "q": "<div>How do you treat PSeudohypothyroidism ?😵</div>", "a": "<summary></summary><p><a href=\"https://www.notion.so/Endocrinology-01a5dbd626254601b1e691c83f3301e5\">same as hypoparathyroidsm</a></p>", "src": "ENDO Anki deck – "}, {"id": "EA0264", "topic": "calcium", "kind": "anki", "q": "<div>VitD deficiency </div>", "a": "<summary></summary>", "src": "ENDO Anki deck – "}, {"id": "EA0265", "topic": "calcium", "kind": "anki", "q": "<div>What are the blood + urine findings in Vit D deficiency ?</div>", "a": "<summary></summary><ul><li>low Ca</li></ul><ul><li>low Phosph</li></ul><ul><li>low urinary Ca</li></ul><ul><li>high PTH</li></ul><ul><li>low 25 Hydroxy VitD</li></ul>", "src": "ENDO Anki deck – "}, {"id": "EA0266", "topic": "calcium", "kind": "anki", "q": "<div>How do you treat Vit D deficiency ?</div>", "a": "<summary></summary><ul><li>Calciferol</li></ul><ul><li>Calcium </li></ul>", "src": "ENDO Anki deck – "}, {"id": "EA0267", "topic": "calcium", "kind": "anki", "q": "<div>Osteoporosis😵🐖</div>", "a": "<summary></summary>", "src": "ENDO Anki deck – "}, {"id": "EA0268", "topic": "calcium", "kind": "anki", "q": "<div>What are the 2 types of osteoporosis?😵</div>", "a": "<summary></summary><p>primary → postmenopausal + age-related</p><p>secondary → <mark>thyrotox, glucocorticoids </mark>+ others that will cause the bone to loose Ca</p>", "src": "ENDO Anki deck – "}, {"id": "EA0269", "topic": "calcium", "kind": "anki", "q": "<div>What are the most common osteoporotic fractures?</div>", "a": "<summary></summary><ul><li>hip</li></ul><ul><li>wrist (Colles')</li></ul><ul><li>vertebral compression fx</li></ul>", "src": "ENDO Anki deck – "}, {"id": "EA0270", "topic": "calcium", "kind": "anki", "q": "<div>What are causes for secondary osteoporosis?😵🐖</div>", "a": "<summary></summary><p><mark>decr. sexhormones+GH, inc. steroids, incr. T4, inc PTH, </mark></p><ol type=\"1\" start=\"1\"><li>Endocrine:<ul><li><mark>Hypogonadism</mark></li></ul><ul><li><mark>Hyperprolactinemia   </mark></li></ul><ul><li><mark>Hyperparathyrodism</mark></li></ul><ul><li><mark>Cushings </mark>syd</li></ul><ul><li><mark>Hyperthyroidsm </mark></li></ul><ul><li><mark>GH + IGF-1</mark> def deficiency </li></ul></li></ol><ol type=\"1\" start=\"2\"><li><mark>GI </mark>→ <mark>malabsorption </mark>syd, Crohns, Liver diseases </li></ol><ol type=\"1\" start=\"3\"><li>Hematologic d → Leukemia, MM</li></ol><ol type=\"1\" start=\"4\"><li>Drugs → <mark>glucos</mark></li></ol>", "src": "ENDO Anki deck – "}, {"id": "EA0271", "topic": "calcium", "kind": "anki", "q": "<div>What is the presentation of osteoporosis?</div>", "a": "<summary></summary><p>silent until acute fracture</p><p>→ vertebral fx → persistence </p><p>Periph fx after <span>low trauma</span></p><p>⇒ no generalized skeletal pain!</p>", "src": "ENDO Anki deck – "}, {"id": "EA0272", "topic": "calcium", "kind": "anki", "q": "<div>What do you measure in Osteoporosis ?</div>", "a": "<summary></summary><p>Estimate Bone mineral density (BMD) with dual -energy X-ray absorptiometry (DXA) ⇒ gives T-score </p>", "src": "ENDO Anki deck – "}, {"id": "EA0273", "topic": "calcium", "kind": "anki", "q": "<div>How do you interpret the T-score? 😵</div>", "a": "<summary></summary><p>T-score = no. of patients standard-deviation of patient BMD below average BMD</p>", "src": "ENDO Anki deck – "}, {"id": "EA0274", "topic": "calcium", "kind": "anki", "q": "<div>What other diagnostic test you wanna consider for Osteoporosis ?😵</div>", "a": "<summary></summary><ul><li><mark>Xray spine </mark>→ vertebral fx?</li></ul><ul><li><mark>fracture risk algorithm assessment </mark>→ clinical risk factor + BMD → 10 year prop for hip-fx + or major osteoporotic fx</li></ul><ul><li>Lab → <mark>check secondary causes for low Ca</mark><ul><li>ESR + CBC</li></ul><ul><li>ALT + AST</li></ul><ul><li>Urea + Crea</li></ul><ul><li>Ca + Phos</li></ul><ul><li>TSH + FT4</li></ul><ul><li>PTH</li></ul><ul><li>Cortisol</li></ul><ul><li>T/E, FSH+LH</li></ul><ul><li>VitD</li></ul></li></ul>", "src": "ENDO Anki deck – "}, {"id": "EA0275", "topic": "calcium", "kind": "anki", "q": "<div>What are the treatment goals in osteoporosis ?</div>", "a": "<summary></summary><p>incr. BMD + decr. fx-risk</p>", "src": "ENDO Anki deck – "}, {"id": "EA0276", "topic": "calcium", "kind": "anki", "q": "<div>What lifestyle meassures can help in osteoporosis ?</div>", "a": "<summary></summary><ul><li>exercise </li></ul><ul><li>Fall prevention + hip protector</li></ul><ul><li>Good diet (enough Ca + VitD)</li></ul>", "src": "ENDO Anki deck – "}, {"id": "EA0277", "topic": "calcium", "kind": "anki", "q": "<div>What about drug therapy for Osteoporosis ?😵</div>", "a": "<summary></summary><p>Antiresorptives:</p><ul><li><mark>Biphosphonate </mark></li></ul><ul><li><mark>Calcitonin </mark></li></ul><ul><li>SERM + <mark>Estrogen </mark></li></ul><ul><li><mark>Denosumab </mark></li></ul><p>Osteo-anabolics:</p><ul><li>Recombinant human <mark>PTH </mark></li></ul><ul><li>Strontium ranelate</li></ul>", "src": "ENDO Anki deck – "}]