[{"id": "OI062", "topic": "uvea", "kind": "img", "q": "<p class=\"muted small\">Lecture 10 – Uvea – slide 8: what does this picture show? Describe it.</p><img data-src=\"data:image/jpeg;base64,\" alt=\"\">", "a": "<h4>Iridocyclitis</h4><ul class=\"sl\"><li class=\"l0\">Pure iritis and cyclitis rarely encountered</li><li class=\"l0\">Mostly inflammation of both structures</li></ul>", "src": "Lecture 10 – Uvea"}, {"id": "OI063", "topic": "uvea", "kind": "img", "q": "<p class=\"muted small\">Lecture 10 – Uvea – slide 31: what does this picture show? Describe it.</p><img data-src=\"data:image/jpeg;base64,\" alt=\"\">", "a": "<h4>Nonsppurative choroiditis</h4><ul class=\"sl\"><li class=\"l0\">Symptoms and signs.</li><li class=\"l0\">Fundus examination</li><li class=\"l1\">one or more choroidal foci</li><li class=\"l2\">white-yellowish prominences, diffuse circumscribed;</li><li class=\"l2\">as the healing  develops the focus becomes pigmented</li><li class=\"l2\">finally an atrophic scar with diminishing VA (central localization)</li></ul>", "src": "Lecture 10 – Uvea"}]